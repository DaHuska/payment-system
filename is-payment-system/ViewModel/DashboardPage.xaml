<Page x:Class="is_payment_system.ViewModel.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="DashboardPage"
      Background="#1f2235"
      WindowHeight="720"
      WindowWidth="1200">

    <Page.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424769"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MakePaymentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="GhostWhite"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2d3250" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="PAYMENT SYSTEM"
                           Foreground="#f9b17a"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WelcomeText"
                                   Text="Welcome, User"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="EmailText"
                                   Text="user@email.com"
                                   Foreground="#aab0d6"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ActiveSidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" Width="24"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Payments_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💳" Width="24"/>
                        <TextBlock Text="Payments"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Transactions_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" Width="24"/>
                        <TextBlock Text="Transactions"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Width="24"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,20,0,0" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Width="24"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2d3250" CornerRadius="18" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Dashboard"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Overview of your account activity"
                                   Foreground="#aab0d6"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right"
                            Background="#424769"
                            CornerRadius="12"
                            Margin="40,0,15,0"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" Foreground="White" Margin="0,0,10,0"/>
                            <TextBlock Text="3 notifications" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,0">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Balance" Foreground="#aab0d6" FontSize="12"/>
                        <TextBlock Text="$12,450"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="+12% this month" Foreground="#7ee787" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Payments" Foreground="#aab0d6" FontSize="12"/>
                        <TextBlock Text="148"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="+24 today" Foreground="#7ee787" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Pending" Foreground="#aab0d6" FontSize="12"/>
                        <TextBlock Text="7"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Needs attention" Foreground="#f9b17a" FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#2d3250" CornerRadius="18" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="Recent Transactions"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="Amazon" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="-$120.50" Foreground="#ff7b7b" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="Salary" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="+$2,300.00" Foreground="#7ee787" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#424769" CornerRadius="12" Padding="12">
                            <DockPanel>
                                <TextBlock Text="Utilities" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="-$86.20" Foreground="#ff7b7b" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2d3250" CornerRadius="18" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Button Content="Make Payment"
                                Height="42"
                                Margin="0,0,0,10"
                                Background="#f9b17a"
                                Foreground="#2d3250"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="MakePayment_Click"
                                Style="{StaticResource MakePaymentButtonStyle}"/>

                        <Button Content="View History"
                                Height="42"
                                Margin="0,0,0,10"
                                Background="#424769"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="ViewHistory_Click"
                                Style="{StaticResource RoundedButtonStyle}"/>

                        <Button Content="Manage Cards"
                                Height="42"
                                Background="#424769"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Style="{StaticResource RoundedButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>