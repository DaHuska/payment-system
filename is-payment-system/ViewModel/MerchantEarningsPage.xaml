<Page x:Class="is_payment_system.ViewModel.MerchantEarningsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="Earnings Management"
      Background="#1f2235"
      WindowHeight="720"
      WindowWidth="1200">

    <Page.Resources>
        <!-- Reuse styles from main page -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424769"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EarningCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5a5f8a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivePeriodButtonStyle" TargetType="Button" BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#2d3250" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="MERCHANT PORTAL"
                           Foreground="#f9b17a"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🏪" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Merchant"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="merchant@store.com"
                                   Foreground="#aab0d6"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="DashboardButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Width="24"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="OrdersButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛍" Width="24"/>
                        <TextBlock Text="Orders"/>
                    </StackPanel>
                </Button>

                <!-- Active Earnings button -->
                <Button Style="{StaticResource ActiveSidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" Width="24"/>
                        <TextBlock Text="Earnings"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="Refunds_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Width="24"/>
                        <TextBlock Text="Refunds"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,20,0,0"
                        Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Width="24"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1"
                      Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

            <StackPanel>
                <!-- Header -->
                <Border Background="#2d3250" CornerRadius="18" Padding="20" Margin="0,0,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Earnings Overview"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Track your revenue, payouts and financial performance"
                                       Foreground="#aab0d6"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Period Selector -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Select Period:" Foreground="#aab0d6" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PeriodButtonStyle}" Content="Today"/>
                                <Button Style="{StaticResource PeriodButtonStyle}" Content="This Week"/>
                                <Button Style="{StaticResource ActivePeriodButtonStyle}" Content="This Month"/>
                                <Button Style="{StaticResource PeriodButtonStyle}" Content="This Year"/>
                                <Button Style="{StaticResource PeriodButtonStyle}" Content="All Time"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Stats Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource EarningCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total Revenue" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$92,540" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="+21% vs last month" Foreground="#7ee787" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource EarningCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Platform Fees" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$4,627" Foreground="#ff7b72" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="5% of revenue" Foreground="#aab0d6" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource EarningCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Net Earnings" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$87,913" Foreground="#7ee787" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="After fees" Foreground="#aab0d6" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource EarningCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pending Payout" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$12,450" Foreground="#f9b17a" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Est. payout in 3 days" Foreground="#aab0d6" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Chart and Payout Summary -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart Section -->
                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Revenue Trend"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>
                            
                            <Border Background="#424769" CornerRadius="12" Padding="16" Height="250">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📈 Revenue Chart"
                                               Foreground="#aab0d6"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Monthly earnings visualization"
                                               Foreground="#676f9d"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="Jan: $8,500 | Feb: $9,200 | Mar: $10,800 | Apr: $12,500 | May: $14,300 | Jun: $15,200"
                                               Foreground="#676f9d"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Margin="0,15,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Payout Summary -->
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Payout Summary"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Last Payout" Foreground="#aab0d6" FontSize="12" Margin="0,5,0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="$8,450" Foreground="White" FontSize="14" FontWeight="Bold" Margin="10,5,0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Next Payout" Foreground="#aab0d6" FontSize="12" Margin="0,5,0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="$12,450" Foreground="#7ee787" FontSize="14" FontWeight="Bold" Margin="10,5,0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Payout Date" Foreground="#aab0d6" FontSize="12" Margin="0,5,0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="2024-02-01" Foreground="White" FontSize="12" Margin="10,5,0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Payout Method" Foreground="#aab0d6" FontSize="12" Margin="0,5,0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Bank Transfer" Foreground="White" FontSize="12" Margin="10,5,0,5"/>
                            </Grid>

                            <Separator Background="#424769" Margin="0,10,0,10"/>
                            
                            <Button Content="Request Early Payout" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,5,0,0"/>
                            <Button Content="Update Payment Method" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,10,0,0" Background="#424769"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Transaction History -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Transaction History"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        
                        <!-- Table Header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Date" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Description" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="Type" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="Amount" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="Status" Foreground="#aab0d6" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#424769" Margin="0,0,0,12"/>

                        <!-- Transaction 1 -->
                        <Grid Margin="0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="2024-01-15" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Order #ORD-2389 - John Carter" Foreground="#d7d9f7" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Sale" Foreground="#7ee787" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="+$120.50" Foreground="#7ee787" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="Green" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                                <TextBlock Text="Completed" 
                                           Foreground="Black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Transaction 2 -->
                        <Grid Margin="0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="2024-01-15" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Order #ORD-2388 - Sarah Wilson" Foreground="#d7d9f7" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Sale" Foreground="#7ee787" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="+$89.00" Foreground="#7ee787" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="Orange" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                                <TextBlock Text="Pending" 
                                           Foreground="black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Transaction 3 -->
                        <Grid Margin="0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="2024-01-14" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Platform Fee - January (5%)" Foreground="#d7d9f7" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Fee" Foreground="#f03c3c" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="-$4,627" Foreground="#f03c3c" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#FF2626" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                                <TextBlock Text="Refunded" 
                                           Foreground="Black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Transaction 4 -->
                        <Grid Margin="0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="2024-01-10" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Order #ORD-2385 - Michael Brown" Foreground="#d7d9f7" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Sale" Foreground="#7ee787" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="+$310.00" Foreground="#7ee787" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="Green" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                                <TextBlock Text="Completed" 
                                           Foreground="Black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Transaction 5 -->
                        <Grid Margin="0,8" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="2024-01-05" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Monthly Payout - December" Foreground="#d7d9f7" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Payout" Foreground="#7ee787" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="-$8,450" Foreground="#f03c3c" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Background="#FF5E5E" CornerRadius="10" Padding="6,4" HorizontalAlignment="Center">
                                <TextBlock Text="Paid" 
                                           Foreground="Black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Separator Background="#424769" Margin="0,15,0,10"/>

                        <!-- Pagination -->
                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Showing 1 to 5 of 47 transactions" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="←" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="1" Style="{StaticResource ActionButtonStyle}" Background="#f9b17a" Foreground="#2d3250" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="2" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="3" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="4" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="→" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="42 more" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>