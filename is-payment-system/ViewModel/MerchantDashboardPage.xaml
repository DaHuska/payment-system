<Page x:Class="is_payment_system.ViewModel.MerchantDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="Merchant Dashboard"
      Background="#1f2235"
      WindowHeight="720"
      WindowWidth="1200">

    <Page.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424769"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="TableCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2d3250" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="MERCHANT PORTAL"
                           Foreground="#f9b17a"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🏪" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Merchant"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="merchant@store.com"
                                   Foreground="#aab0d6"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ActiveSidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Width="24"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="OrdersButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛍" Width="24"/>
                        <TextBlock Text="Orders"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="EarningsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" Width="24"/>
                        <TextBlock Text="Earnings"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Refunds_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Width="24"/>
                        <TextBlock Text="Refunds"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,20,0,0" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Width="24"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2d3250" CornerRadius="18" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Merchant Dashboard"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Track orders, revenue, refunds and product activity"
                                       Foreground="#aab0d6"
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Total Orders" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="3,482" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="+16% this month" Foreground="#7ee787" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Revenue" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$92,540" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="+21% this month" Foreground="#7ee787" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pending Orders" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="48" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Needs action" Foreground="#f9b17a" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Refund Rate" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="2.4%" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="-0.3% this month" Foreground="#7ee787" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,15,15">
                        <StackPanel>
                            <TextBlock Text="Recent Orders"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Customer" Style="{StaticResource TableCellText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Amount" Style="{StaticResource TableCellText}" FontWeight="Bold" Margin="0,0,25,0"/>
                                <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource TableCellText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Method" Style="{StaticResource TableCellText}" FontWeight="Bold"/>
                            </Grid>

                            <Separator Background="#424769" Margin="0,6,0,8"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="John Carter" Style="{StaticResource TableCellText}"/>
                                <TextBlock Grid.Column="1" Text="$120.50" Style="{StaticResource TableCellText}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="2" Text="Completed" Style="{StaticResource TableCellText}" Foreground="#7ee787"/>
                                <TextBlock Grid.Column="3" Text="Card" Style="{StaticResource TableCellText}" Margin="10,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Sarah Wilson" Style="{StaticResource TableCellText}"/>
                                <TextBlock Grid.Column="1" Text="$89.00" Style="{StaticResource TableCellText}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="2" Text="Pending" Style="{StaticResource TableCellText}" Foreground="#f9b17a"/>
                                <TextBlock Grid.Column="3" Text="Wallet" Style="{StaticResource TableCellText}" Margin="10,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Mark Lee" Style="{StaticResource TableCellText}"/>
                                <TextBlock Grid.Column="1" Text="$240.00" Style="{StaticResource TableCellText}" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="2" Text="Refunded" Style="{StaticResource TableCellText}" Foreground="#ff7b72"/>
                                <TextBlock Grid.Column="3" Text="Cash" Style="{StaticResource TableCellText}" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Merchant Activity"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="New order received" Foreground="White"/>
                                    <TextBlock Text="2 minutes ago" Foreground="#aab0d6" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Refund request opened" Foreground="White"/>
                                    <TextBlock Text="18 minutes ago" Foreground="#aab0d6" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Payout processed" Foreground="White"/>
                                    <TextBlock Text="Today" Foreground="#aab0d6" FontSize="11"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Sales Overview"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>
                            <Border Background="#424769" CornerRadius="12" Padding="16" Height="180">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Chart placeholder"
                                               Foreground="#aab0d6"
                                               HorizontalAlignment="Center"
                                               FontSize="14"/>
                                    <TextBlock Text="Insert LiveCharts or another chart control here"
                                               Foreground="#676f9d"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Actions"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Button Content="Manage Orders" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,10"/>
                            <Button Content="Review Refunds" Style="{StaticResource ActionButtonStyle}" Height="40" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>