<Page x:Class="is_payment_system.ViewModel.MerchantOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="Orders Management"
      Background="#1f2235"
      WindowHeight="720"
      WindowWidth="1200">

    <Page.Resources>
        <!-- Reuse styles from main page for consistency -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424769"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status badge styles -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="90"/>
        </Style>

        <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5a5f8a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (same as main page) -->
        <Border Background="#2d3250" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="MERCHANT PORTAL"
                           Foreground="#f9b17a"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🏪" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Merchant"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="merchant@store.com"
                                   Foreground="#aab0d6"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="DashboardButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Width="24"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <!-- Active Orders button -->
                <Button Style="{StaticResource ActiveSidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛍" Width="24"/>
                        <TextBlock Text="Orders"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="EarningsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" Width="24"/>
                        <TextBlock Text="Earnings"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,0,0,8"
                        Click="Refunds_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Width="24"/>
                        <TextBlock Text="Refunds"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" 
                        Margin="0,20,0,0"
                        Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Width="24"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1"
                      Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

            <StackPanel>
                <!-- Header -->
                <Border Background="#2d3250" CornerRadius="18" Padding="20" Margin="0,0,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Orders Management"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="View, manage and track all customer orders"
                                       Foreground="#aab0d6"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Stats Row -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#2d3250" CornerRadius="18" Padding="15" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Total Orders" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="3,482" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="+16% vs last period" Foreground="#7ee787" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#2d3250" CornerRadius="18" Padding="15" Margin="12,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Pending Fulfillment" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="48" Foreground="#f9b17a" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="Requires attention" Foreground="#aab0d6" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#2d3250" CornerRadius="18" Padding="15" Margin="12,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Today's Orders" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="127" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="+8 from yesterday" Foreground="#aab0d6" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#2d3250" CornerRadius="18" Padding="15" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Avg. Order Value" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="$87.50" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="↑ $4.20" Foreground="#7ee787" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filters and Search -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Filter by:" Foreground="#aab0d6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ToggleButton Style="{StaticResource FilterButtonStyle}" Content="All Orders" IsChecked="True"/>
                                <ToggleButton Style="{StaticResource FilterButtonStyle}" Content="Pending"/>
                                <ToggleButton Style="{StaticResource FilterButtonStyle}" Content="Completed"/>
                                <ToggleButton Style="{StaticResource FilterButtonStyle}" Content="Refunded"/>
                                <ToggleButton Style="{StaticResource FilterButtonStyle}" Content="Cancelled"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                     Margin="20,0"
                                     VerticalAlignment="Center">
                                <TextBox.Tag>
                                    <TextBlock Text="🔍 Search orders by customer or ID..." Foreground="#aab0d6" IsHitTestVisible="False"/>
                                </TextBox.Tag>
                                <TextBox.Text>
                                    <Binding Path="Tag.Text" RelativeSource="{RelativeSource Self}" UpdateSourceTrigger="PropertyChanged"/>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Orders Table -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Order ID" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Customer" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="Date" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="Amount" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="Items" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="5" Text="Status" Foreground="#aab0d6" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Grid.Column="6" Text="Action" Foreground="#aab0d6" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#424769" Margin="0,0,0,12"/>

                        <!-- Order Row 1 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2389" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="John Carter" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-15" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$120.50" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="3 items" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="green">
                                <TextBlock Text="Completed" 
                                           Foreground="Black" FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="1,1,0,0"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <!-- Order Row 2 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2388" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Sarah Wilson" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-15" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$89.00" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="2 items" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="Orange">
                                <TextBlock Text="Pending" 
                                           Foreground="black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <!-- Order Row 3 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2387" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Mark Lee" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-14" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$240.00" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="5 items" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="#FF2626">
                                <TextBlock Text="Refunded" 
                                           Foreground="Black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <!-- Order Row 4 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2386" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Emily Davis" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-14" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$45.99" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="1 item" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="Green">
                                <TextBlock Text="Completed" 
                                           Foreground="Black" FontSize="13" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="1,1,0,0"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <!-- Order Row 5 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2385" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Michael Brown" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-13" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$310.00" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="4 items" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="Orange">
                                <TextBlock Text="Pending" 
                                           Foreground="black" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <!-- Order Row 6 -->
                        <Grid Margin="0,10" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#ORD-2384" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Lisa Anderson" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="2024-01-13" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="$67.50" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="2 items" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Style="{StaticResource StatusBadgeStyle}" Background="#424769">
                                <TextBlock Text="Cancelled" 
                                           Foreground="#aab0d6" 
                                           FontSize="13" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="6" Content="Details" Style="{StaticResource ActionButtonStyle}" Width="70" Height="28" Padding="0"/>
                        </Grid>

                        <Separator Background="#424769" Margin="0,15,0,10"/>

                        <!-- Pagination -->
                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Showing 1 to 6 of 3,482 orders" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="←" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="1" Style="{StaticResource ActionButtonStyle}" Background="#f9b17a" Foreground="#2d3250" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="2" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="3" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="4" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="5" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="…" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,3,0"/>
                                <Button Content="→" Style="{StaticResource ActionButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="3,476 more" Foreground="#aab0d6" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Actions Section -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Bulk Actions" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="Select multiple orders to perform bulk operations" Foreground="#aab0d6" FontSize="12" Margin="0,0,0,15"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📦 Bulk Update Status" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Height="36"/>
                                <Button Grid.Column="1" Content="🖨️ Bulk Print Invoices" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" Height="36"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Order Status Guide" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Border Background="Green" CornerRadius="10" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Completed" Foreground="#aab0d6" FontSize="12" Margin="0,0,15,0"/>
                                
                                <Border Background="Orange" CornerRadius="10" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Pending" Foreground="#aab0d6" FontSize="12" Margin="0,0,15,0"/>
                                
                                <Border Background="#f03c3c" CornerRadius="10" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Refunded" Foreground="#aab0d6" FontSize="12" Margin="0,0,15,0"/>
                                
                                <Border Background="#424769" CornerRadius="10" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancelled" Foreground="#aab0d6" FontSize="12"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>