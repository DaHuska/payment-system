<Page x:Class="is_payment_system.ViewModel.RefundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="Refund"
      Background="#1f2235"
      WindowHeight="720"
      WindowWidth="1200">

    <Page.Resources>

        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="GhostWhite"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,10,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#888"
                                       Margin="0"
                                       Padding="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d7d9f7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424769"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f9b17a"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
        </Style>

        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#2d3250" CornerRadius="0,20,20,0">
            <StackPanel Margin="20">
                <TextBlock Text="PAYMENT SYSTEM"
                           Foreground="#f9b17a"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,10,0,30"
                           HorizontalAlignment="Center"/>

                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Welcome, User"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="user@email.com"
                                   Foreground="#aab0d6"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Dashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" Width="24"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Payments_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💳" Width="24"/>
                        <TextBlock Text="Payments"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,8" Click="Transactions_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾" Width="24"/>
                        <TextBlock Text="Transactions"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActiveSidebarButtonStyle}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Width="24"/>
                        <TextBlock Text="Refund"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,20,0,0" Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Width="24"/>
                        <TextBlock Text="Logout"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2d3250" CornerRadius="18" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Refund Request"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Review the payment and submit a refund request"
                                       Foreground="#aab0d6"
                                       FontSize="12"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Right"
                                Background="#424769"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="40,0,15,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="Pending approval" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Transaction Info"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="Transaction ID" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="#TXN-2026-0048" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,12"/>

                                <TextBlock Text="Recipient" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="Amazon" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,12"/>

                                <TextBlock Text="Paid Amount" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="$120.50" Foreground="#f9b17a" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Refund Details"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="Refund Amount" Foreground="#aab0d6" FontSize="12"/>
                                <Border Background="#424769" CornerRadius="12" Margin="0,6,0,12" Padding="10,0">
                                    <TextBox Style="{StaticResource WatermarkTextBox}"
                                             Text=""
                                             Tag="Enter refund amount"/>
                                </Border>

                                <TextBlock Text="Reason" Foreground="#aab0d6" FontSize="12"/>
                                <Border Background="#424769" CornerRadius="12" Margin="0,6,0,12" Padding="10,0">
                                    <TextBox Style="{StaticResource WatermarkTextBox}"
                                             Height="110"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             HorizontalContentAlignment="Left"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Tag="Enter refund reason"/>
                                </Border>

                                <TextBlock Text="Request Note" Foreground="#aab0d6" FontSize="12"/>
                                <Border Background="#424769" CornerRadius="12" Margin="0,6,0,0" Padding="10,0">
                                    <TextBox Style="{StaticResource WatermarkTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Tag="Add a note for this refund"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <Border Background="#2d3250" CornerRadius="18" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Refund Summary"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="Original Payment" Foreground="#d7d9f7"/>
                                        <TextBlock Text="$120.50" Foreground="White" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Border>

                                <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock Text="Refund Fee" Foreground="#d7d9f7"/>
                                        <TextBlock Text="$0.50" Foreground="White" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Border>

                                <Border Background="#424769" CornerRadius="12" Padding="12">
                                    <DockPanel>
                                        <TextBlock Text="Total Refund" Foreground="#d7d9f7" FontWeight="Bold"/>
                                        <TextBlock Text="$120.00" Foreground="#7ee787" DockPanel.Dock="Right" FontWeight="Bold"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#2d3250" CornerRadius="18" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Actions"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <Button Content="Submit Refund"
                                        Height="42"
                                        Margin="0,0,0,10"
                                        Background="#f9b17a"
                                        Foreground="#2d3250"
                                        Style="{StaticResource RoundedActionButtonStyle}"/>

                                <Button Content="Cancel Request"
                                        Height="42"
                                        Margin="0,0,0,10"
                                        Click="CancelRequest_Click"
                                        Style="{StaticResource RoundedActionButtonStyle}"/>

                                <Button Content="Back to Payment Details"
                                        Height="42"
                                        Click="BackToPaymentDetails_Click"
                                        Style="{StaticResource RoundedActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>