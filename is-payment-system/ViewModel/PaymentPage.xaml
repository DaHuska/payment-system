<Page x:Class="is_payment_system.ViewModel.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="Payment"
      Background="#1f2235"
      WindowHeight="700"
      WindowWidth="1100">

    <Page.Resources>

        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="GhostWhite"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,10,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#888"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f9b17a"/>
            <Setter Property="Foreground" Value="#2d3250"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Border Background="#2d3250"
                BorderBrush="#424769"
                BorderThickness="1"
                CornerRadius="20"
                Width="1000"
                Height="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="40" VerticalAlignment="Center">

                    <TextBlock Text="PAYMENT"
                               Foreground="#f9b17a"
                               FontWeight="Bold"
                               FontSize="12"/>

                    <TextBlock Text="Complete your transaction."
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,10,0,25"/>

                    <Border CornerRadius="15" Background="#424769" Margin="0,0,0,12" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💳" Foreground="#676f9d" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource WatermarkTextBox}"
                                     Tag="Card number"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="15" Background="#424769" Margin="0,0,0,12" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" Foreground="#676f9d" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource WatermarkTextBox}"
                                     Tag="Cardholder name"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="15" Background="#424769" Margin="0,0,6,0" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📅" Foreground="#676f9d" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource WatermarkTextBox}"
                                         Tag="MM/YY"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="15" Background="#424769" Margin="6,0,0,0" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" Foreground="#676f9d" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource WatermarkTextBox}"
                                         Tag="CVV"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border CornerRadius="15" Background="#424769" Margin="0,0,0,18" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💶" Foreground="#676f9d" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource WatermarkTextBox}"
                                     Tag="Amount"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="15" Background="#f9b17a">
                        <Button Content="PAY NOW"
                                Height="42"
                                FontSize="12"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="PayNow_Click"
                                Style="{StaticResource RoundedButtonStyle}"/>
                    </Border>

                </StackPanel>

                <Border Grid.Column="1"
                        Background="#1f2235"
                        CornerRadius="0,20,20,0"
                        Padding="30">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SUMMARY"
                                   Foreground="#f9b17a"
                                   FontWeight="Bold"
                                   FontSize="12"/>

                        <TextBlock Text="Payment Details"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,25"/>

                        <Border Background="#2d3250" CornerRadius="18" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recipient" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="Payment System Ltd." Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2d3250" CornerRadius="18" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Total" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="$149.99" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2d3250" CornerRadius="18" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Note" Foreground="#aab0d6" FontSize="12"/>
                                <TextBlock Text="Secure payment processing with encrypted card details."
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>