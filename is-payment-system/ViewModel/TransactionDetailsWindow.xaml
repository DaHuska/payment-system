<Window x:Class="is_payment_system.ViewModel.TransactionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:is_payment_system.ViewModel"
        mc:Ignorable="d"
        Title="Payment Details"
        Background="#1f2235"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2d3250"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>

        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#424769"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc599"/>
                                <Setter Property="Foreground" Value="#2d3250"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2d3250" CornerRadius="18" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Payment Details"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                    <TextBlock Text="Review the full information for this payment"
                               Foreground="#aab0d6"
                               FontSize="12"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="#424769"
                        CornerRadius="12"
                        Margin="40,0,15,0"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Status}" Foreground="White"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recipient" Foreground="#aab0d6" FontSize="12"/>
                        <TextBlock Text="{Binding Recipient}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Description}" Foreground="#d7d9f7" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Transaction ID" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="{Binding TransactionIdText}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Date" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="{Binding Date}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource InfoCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Payment Method" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="{Binding PaymentMethod}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Status" Foreground="#aab0d6" FontSize="12"/>
                            <TextBlock Text="{Binding Status}" Foreground="#7ee787" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Notes" Foreground="#aab0d6" FontSize="12"/>
                        <TextBlock Text="{Binding Notes}"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Background="#2d3250" CornerRadius="18" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Summary"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="Subtotal" Foreground="#d7d9f7"/>
                                <TextBlock Text="{Binding Subtotal}" Foreground="White" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#424769" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="Fee" Foreground="#d7d9f7"/>
                                <TextBlock Text="{Binding Fee}" Foreground="White" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <Border Background="#424769" CornerRadius="12" Padding="12">
                            <DockPanel>
                                <TextBlock Text="Total" Foreground="#d7d9f7" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Total}" Foreground="#f9b17a" DockPanel.Dock="Right" FontWeight="Bold"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#2d3250" CornerRadius="18" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Actions"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Button Content="Download Receipt"
                                Height="42"
                                Margin="0,0,0,10"
                                Style="{StaticResource RoundedActionButtonStyle}"/>

                        <Button Content="Refund Payment"
                                Height="42"
                                Margin="0,0,0,10"
                                Style="{StaticResource RoundedActionButtonStyle}"/>

                        <Button Content="Close"
                                Height="42"
                                Style="{StaticResource RoundedActionButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>