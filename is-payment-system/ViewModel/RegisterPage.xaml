<Page x:Class="is_payment_system.ViewModel.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:is_payment_system.ViewModel"
      mc:Ignorable="d"
      Title="RegisterPage" Height="450" Width="800">

    <Page.DataContext>
        <local:AddRecordsViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="GhostWhite"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,10,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#888"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border Background="#2d3250"
                CornerRadius="20"
                Width="800"
                Height="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="40">

                    <TextBlock Text="START FOR FREE"
                               Foreground="#f9b17a"
                               FontWeight="Bold"
                               FontSize="12"/>

                    <TextBlock Text="Create new account."
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,10"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="15" Background="#424769" Margin="0,0,5,0" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" Foreground="#676f9d" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource WatermarkTextBox}"
                                         Tag="First name"
                                         Text="{Binding NewUserFirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="15" Background="#424769" Margin="5,0,0,0" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" Foreground="#676f9d" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource WatermarkTextBox}"
                                         Tag="Last name"
                                         Text="{Binding NewUserLastName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border CornerRadius="15" Background="#424769" Margin="0,0,0,10" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📧" Foreground="#676f9d" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource WatermarkTextBox}"
                                     Tag="Email"
                                     Text="{Binding NewUserEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="15" Background="#424769" Margin="0,0,0,15" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" Foreground="#676f9d" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <PasswordBox x:Name="PasswordBox"
                                             Background="Transparent"
                                             Foreground="White"
                                             CaretBrush="GhostWhite"
                                             BorderThickness="0"
                                             Padding="10,10,0,10"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBlock x:Name="PasswordWatermark"
                                           Text="Password"
                                           Foreground="#888"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border CornerRadius="15" Background="#f9b17a">
                        <Button Content="CREATE ACCOUNT"
                                Height="35"
                                Padding="10,0"
                                FontSize="11"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Background="#f9b17a"
                                Foreground="#2d3250"
                                Click="CreateAccount_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#f9b17a"/>
                                    <Setter Property="Foreground" Value="#2d3250"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Background"
                                                                Value="#ffc599"/>
                                                        <Setter Property="Foreground" Value="GhostWhite"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border"
                                                                Property="Opacity"
                                                                Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>

                    <Button Content="Back to Login"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="#f9b17a"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BackToLogin_Click"/>

                </StackPanel>

                <Border Grid.Column="1" CornerRadius="0,20,20,0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/register_bg.png"
                           Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>